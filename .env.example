# ==========================================================================
# MARAVI Pedidos — variáveis de ambiente (copie para .env e preencha)
# Nenhum valor abaixo é credencial real.
# ==========================================================================

# desenvolvimento | homologacao | producao
APP_ENV=desenvolvimento
PORT=3000
HOST=0.0.0.0

# URL pública do app (usada para validar Origin em requisições que alteram dados
# e para montar links de recuperação de senha). Ex.: https://pedidos.maravi.com.br
APP_URL=http://localhost:3000

# PostgreSQL local: preencha estes valores apenas no arquivo .env (ignorado pelo Git).
POSTGRES_PASSWORD=
DATABASE_URL=
# Banco usado apenas pelos testes automatizados (será limpo a cada execução!)
TEST_DATABASE_URL=

# Atrás de proxy reverso (Nginx, Render, Railway...): true para usar o IP real do cliente
# nos limites de tentativas. Deixe false se o app é exposto diretamente.
TRUST_PROXY=false
# Origens extras aceitas em requisições que alteram dados (separe por vírgula).
# Em desenvolvimento com o Vite (npm run dev:web) use: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --------------------------------------------------------------------------
# Pix
# desabilitado : nenhuma cobrança é criada (padrão seguro)
# simulado     : provedor FALSO, apenas em desenvolvimento/homologação. Nunca cobra de verdade.
# real         : exige provedor homologado (hoje NÃO implementado — ver docs/HOMOLOGACAO.md)
# --------------------------------------------------------------------------
PIX_MODE=desabilitado
# Segredo HMAC que autentica os eventos (webhooks) do provedor Pix.
# No modo simulado serve para assinar os eventos simulados internamente.
PIX_WEBHOOK_SECRET=
# Preencher somente quando a integração real for homologada:
PIX_PROVIDER=
PIX_PROVIDER_BASE_URL=
PIX_PROVIDER_CLIENT_ID=
PIX_PROVIDER_CLIENT_SECRET=
PIX_RECEIVER_KEY=
PIX_RECEIVER_NAME=MARAVI
PIX_RECEIVER_CITY=SAO LUIS

# --------------------------------------------------------------------------
# E-mail (recuperação de senha). Sem SMTP configurado as mensagens ficam na
# tabela outbox_emails e, em desenvolvimento, o link aparece no log do servidor.
# --------------------------------------------------------------------------
SMTP_URL=
MAIL_FROM="MARAVI <nao-responder@maravi.example>"

# --------------------------------------------------------------------------
# Dados de demonstração (somente npm run db:seed, bloqueado em producao)
# --------------------------------------------------------------------------
SEED_PASSWORD=

# Custo do hash de senha (scrypt, 10–18). 15 é o padrão; testes usam 10.
SCRYPT_COST=15
# Pasta das imagens enviadas (padrão: server/uploads)
# UPLOAD_DIR=
